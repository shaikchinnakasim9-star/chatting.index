{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        "connections": {
          "$connectionId": {
            ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
            ".validate": "newData.val() === true"
          }
        }
      }
    }
  }
}
